# Admin access for the management pages and API mutations.
# Copy this file to .env.local and replace the placeholders with real values.
# Never commit real credentials or secrets.

# Username and password checked by POST /api/admin/login.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=your-session-secret
